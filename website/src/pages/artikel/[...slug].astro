---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeilenLeiste from "../../components/TeilenLeiste.astro";
import Rueckmeldung from "../../components/Rueckmeldung.astro";
import { SITE } from "../../config.js";

export async function getStaticPaths() {
  const alle = await getCollection("artikel", ({ data }) => !data.draft);
  return alle.map((eintrag) => ({
    params: { slug: eintrag.id },
    props: { eintrag },
  }));
}

const { eintrag } = Astro.props;
const { Content } = await render(eintrag);
const d = eintrag.data;

const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Article schema on every page; FAQPage added when the frontmatter defines
// questions. Both are eligible for rich results in Google.
const schema: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": d.type === "vergleich" ? "Article" : "Article",
    headline: d.title,
    description: d.description,
    inLanguage: SITE.language,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    author: { "@type": "Person", name: SITE.author },
    publisher: { "@type": "Organization", name: SITE.name },
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Start", item: SITE.url },
      {
        "@type": "ListItem",
        position: 2,
        name: "Vergleiche",
        item: `${SITE.url}/artikel/`,
      },
      { "@type": "ListItem", position: 3, name: d.title, item: url },
    ],
  },
];

if (d.faq.length > 0) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: d.faq.map((f) => ({
      "@type": "Question",
      name: f.frage,
      acceptedAnswer: { "@type": "Answer", text: f.antwort },
    })),
  });
}

const datum = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(d.updated ?? d.published);
---

<BaseLayout title={d.title} description={d.description} schema={schema}>
  <article class="shell beitrag">
    <header>
      <p class="eyebrow">
        {d.type === "vergleich" ? "Vergleich" : d.type === "test" ? "Test" : "Ratgeber"}
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="meta ui">
        {d.updated ? "Aktualisiert" : "Veröffentlicht"} am <time
          datetime={(d.updated ?? d.published).toISOString()}>{datum}</time
        >
      </p>
      <TeilenLeiste titel={d.title} pfad={Astro.url.pathname} kompakt={true} />
    </header>

    <div class="inhalt">
      <Content />
    </div>

    {
      d.faq.length > 0 && (
        <section class="faq">
          <h2>Häufige Fragen</h2>
          {d.faq.map((f) => (
            <details>
              <summary>{f.frage}</summary>
              <p>{f.antwort}</p>
            </details>
          ))}
        </section>
      )
    }
    <footer class="artikel-fuss">
      <Rueckmeldung quelle="artikel" frage="War dieser Vergleich hilfreich?" />

      <p class="weitersagen">Hat dir der Vergleich geholfen? Dann gib ihn weiter.</p>
      <TeilenLeiste titel={d.title} pfad={Astro.url.pathname} />
    </footer>
  </article>
</BaseLayout>

<style>
  .beitrag {
    padding-block: 3rem 1rem;
  }
  .lead {
    font-size: 1.13rem;
    color: var(--ink-soft);
    max-width: 58ch;
  }
  .meta {
    font-size: 0.82rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
  }
  .artikel-fuss {
    margin-top: 3rem;
  }
  .weitersagen {
    margin-top: 2.25rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .faq {
    margin-top: 3rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.5rem;
  }
  details {
    border-bottom: 1px solid var(--rule);
    padding: 0.9rem 0;
    max-width: var(--measure);
  }
  summary {
    font-family: Archivo, sans-serif;
    font-weight: 600;
    font-size: 0.98rem;
    cursor: pointer;
  }
  details p {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }
</style>
