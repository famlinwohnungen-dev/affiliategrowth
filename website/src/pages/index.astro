---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ErkennungsGrafik from "../components/ErkennungsGrafik.astro";
import { SITE } from "../config.js";

const artikel = (await getCollection("artikel", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

// Bewusst KEINE Affiliate-Links auf der Startseite. Sie hat genau eine
// Aufgabe: Leser in den passenden Artikel bringen. Verdient wird dort, nach
// der Argumentation — nicht davor. Eine Startseite voller Partnerlinks ohne
// Inhalt ist zudem genau das, was Google als "thin affiliate page" abwertet.

const einstiege = [
  {
    frage: "Ich will zwei Produkte direkt vergleichen",
    ziel: "/artikel/",
    hinweis: "Direktvergleiche",
  },
  {
    frage: "Ich weiß noch nicht, worauf es ankommt",
    ziel: "/anbieter/",
    hinweis: "Die Anbieter im Überblick",
  },
];

// Der frühere dritte Einstieg ("Wie kommen diese Empfehlungen zustande?")
// führte auf /methodik/ und passte hier nicht: Wer auf der Startseite steht,
// sucht ein Produkt, nicht unsere Arbeitsweise. Die Methodik bleibt über die
// Kopfzeile erreichbar, wo sie hingehört.
//
// Der Platz gehört der meistgestellten Frage der Nische — "reicht Windows
// Defender?" (PLAN.md, Artikel 11). Der Einstieg kommt zurück, sobald der
// Artikel steht; bis dahin lieber zwei echte Wege als drei mit einem
// Blindgänger.

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.language,
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description} schema={schema}>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-text">
        {/* HAC — siehe ../../content/SCHREIBWEISE.md */}
        <h1>Alle erkennen fast alles. Trotzdem ist die Wahl nicht egal.</h1>
        <p class="lead">
          Zwischen 99,6 % und 99,8 % Erkennung liegt kein Unterschied, den du je
          bemerken würdest — genau darauf vergleichen aber die meisten Ranglisten.
        </p>
        <p class="lead">
          Es ist wie bei Versicherungen: Der Schutz ähnelt sich bei allen
          Anbietern, der Unterschied steckt im Kleingedruckten und im Preis nach
          dem ersten Jahr. Wenn du gerade vor einer Verlängerung stehst oder einen
          neuen Rechner einrichtest, ist das die Frage, die zählt.
        </p>
        <a class="cta" href="/artikel/">Zu den Vergleichen</a>
      </div>

      <div class="hero-bild">
        <ErkennungsGrafik />
      </div>
    </div>
  </section>

  <section class="shell block">
    <h2 class="sr-only">Einstiege</h2>
    <ul class="einstiege">
      {
        einstiege.map((e) => (
          <li>
            <a href={e.ziel}>
              <span class="frage">{e.frage}</span>
              <span class="hinweis">
                {e.hinweis}
                <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                  <path
                    d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell block">
    <header class="block-kopf">
      <h2>Aktuelle Vergleiche</h2>
      {artikel.length > 0 && <a class="mehr" href="/artikel/">Alle ansehen</a>}
    </header>

    {
      artikel.length === 0 ? (
        <p class="leer">
          Noch kein Artikel veröffentlicht. Der erste entsteht unter{" "}
          <code>src/content/artikel/</code>.
        </p>
      ) : (
        <div class="raster">
          {artikel.slice(0, 6).map((a) => (
            <a class="artikel-karte" href={`/artikel/${a.id}/`}>
              <span class="art">
                {a.data.type === "vergleich"
                  ? "Vergleich"
                  : a.data.type === "test"
                    ? "Test"
                    : "Ratgeber"}
              </span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
            </a>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero {
    --schild: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M12%201.8%2021%205.6v6.6c0%204.9-3.9%208.5-9%2010-5.1-1.5-9-5.1-9-10V5.6z%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%20stroke-width%3D%221.2%22%20stroke-linejoin%3D%22round%22%2F%3E%3Cpath%20d%3D%22M12%206.4%2015.1%2013.6%2012%2012.1%208.9%2013.6z%22%20fill%3D%22%23000%22%2F%3E%3Cpath%20d%3D%22M12%2017.4%208.9%2013.6%2012%2015.1%2015.1%2013.6z%22%20fill%3D%22%23000%22%2F%3E%3C%2Fsvg%3E");
    position: relative;
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
    padding-block: 3.75rem 3.25rem;
    overflow: hidden;
  }
  /* Bildmarke als blasses Wasserzeichen statt eines Stockfotos: füllt die
     Fläche, kostet keinen Request und bleibt die eigene Marke. Rein
     dekorativ, deshalb als Hintergrund und nicht im Dokument. */
  .hero::before {
    content: "";
    position: absolute;
    right: -3rem;
    top: 50%;
    transform: translateY(-50%);
    width: 26rem;
    height: 26rem;
    pointer-events: none;
    opacity: 0.035;
    background: var(--accent);
    -webkit-mask: var(--schild) center / contain no-repeat;
    mask: var(--schild) center / contain no-repeat;
  }
  @media (max-width: 52rem) {
    .hero::before {
      display: none;
    }
  }
  /* Zweispaltig ab Tablet: links das Argument, rechts das Schaubild dazu.
     Darunter einspaltig — auf dem Telefon steht die Grafik unter dem Text,
     nie daneben. */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 2rem;
  }
  @media (min-width: 52rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 1fr);
      gap: 3rem;
    }
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .hero-bild {
    min-width: 0;
  }
  .hero h1 {
    margin: 0;
    max-width: 18ch;
  }
  .lead {
    font-size: 1.14rem;
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0;
  }
  .cta {
    display: inline-block;
    margin-top: 0.35rem;
    background: var(--accent);
    color: #fff;
    font-family: Archivo, sans-serif;
    font-weight: 600;
    font-size: 0.94rem;
    text-decoration: none;
    padding: 0.7rem 1.35rem;
    border-radius: var(--radius);
    transition: background-color 0.15s ease;
  }
  .cta:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .block {
    padding-block: 3rem 0;
  }
  .block-kopf {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.35rem;
  }
  .block-kopf h2 {
    margin: 0;
  }
  .mehr {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: Archivo, sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Einstiege: drei Wege in den passenden Inhalt, keine Partnerlinks. */
  /* Volle Spaltenzahl oder eine — nie dazwischen, sonst bleibt eine Zelle
     leer und die Rasterfarbe scheint als grauer Block durch. */
  .einstiege {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 44rem) {
    .einstiege {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .einstiege a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
    background: var(--surface);
    padding: 1.2rem 1.3rem 1.15rem;
    text-decoration: none;
    color: inherit;
  }
  .einstiege a:hover {
    background: var(--surface-alt);
  }
  .frage {
    font-size: 1rem;
    color: var(--ink);
  }
  .einstiege .hinweis {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: Archivo, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1rem;
  }
  .artikel-karte {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem 1.3rem;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .artikel-karte:hover {
    border-color: var(--accent);
  }
  .art {
    font-family: Archivo, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .artikel-karte h3 {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .artikel-karte p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .leer {
    color: var(--ink-faint);
  }
</style>
