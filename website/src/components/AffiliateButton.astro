---
import { MERCHANTS } from "../config.js";

interface Props {
  merchant: keyof typeof MERCHANTS | string;
  label?: string;
  variant?: "primary" | "quiet";
}

const { merchant, label, variant = "primary" } = Astro.props;
const m = MERCHANTS[merchant as keyof typeof MERCHANTS];

if (!m) throw new Error(`AffiliateButton: unknown merchant "${merchant}"`);

// Links route through /go/ so tracking URLs live in one place and clicks stay
// measurable. rel="sponsored nofollow" is required by Google for paid links.
//
// `?from=` hängt die Quellseite an. Damit steht in der Statistik nicht nur
// "jemand hat auf Bitdefender geklickt", sondern aus welchem Artikel heraus —
// die einzige Zahl, die verrät, welcher Text tatsächlich Geld verdient.
const quelle = Astro.url.pathname.replace(/^\/|\/$/g, "") || "startseite";
const href = `/go/${merchant}/?from=${encodeURIComponent(quelle)}`;
---

{/*
  Das Sternchen ist die Werbekennzeichnung direkt am Link. Rechtlich sicherer
  als ein Hinweis nur im Footer und deutlich unaufdringlicher als ein Absatz.
  Aufgelöst wird es im Footer.
*/}
<a class:list={["aff", variant]} href={href} rel="sponsored nofollow noopener" target="_blank">
  <span>{label ?? `Zu ${m.name}`}<span class="stern" aria-hidden="true">*</span></span>
  <span class="sr-only">(Affiliate-Link)</span>
  <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13">
    <path
      d="M5 3h8v8M13 3L3.5 12.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
  </svg>
</a>

<style>
  .aff {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: Archivo, sans-serif;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    padding: 0.6rem 1rem;
    transition: background-color 0.15s ease;
  }
  .stern {
    opacity: 0.65;
    margin-left: 0.12em;
    font-weight: 500;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .primary {
    background: var(--accent);
    color: #fff;
  }
  .primary:hover {
    background: var(--accent-hover);
    color: #fff;
  }
  .quiet {
    border: 1px solid var(--rule);
    color: var(--ink);
    background: var(--surface);
  }
  .quiet:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
