---
import { SITE } from "../config.js";

/**
 * Teilen-Leiste. Bewusst nur Links, keine Hersteller-SDKs: Ein eingebundenes
 * Facebook- oder X-Skript würde Besucher tracken, bevor irgendjemand klickt —
 * und damit die Einwilligungsfreiheit dieser Seite zerstören.
 *
 * Instagram und TikTok haben keine Web-Schnittstelle zum Teilen. Der einzige
 * Weg dorthin ist das native Teilen-Menü des Geräts (Web Share API), das
 * unten als erster Knopf erscheint, sobald der Browser es unterstützt.
 */
interface Props {
  titel: string;
  pfad: string;
  kompakt?: boolean;
}

const { titel, pfad, kompakt = false } = Astro.props;

const url = new URL(pfad, SITE.url).href;
const t = encodeURIComponent(titel);
const u = encodeURIComponent(url);

const dienste = [
  {
    id: "whatsapp",
    name: "WhatsApp",
    href: `https://wa.me/?text=${t}%20${u}`,
    pfadD:
      "M12 2a9.9 9.9 0 0 0-8.5 15L2 22l5.2-1.4A9.9 9.9 0 1 0 12 2m0 1.8a8.1 8.1 0 1 1-4.1 15.1l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 0 1 12 3.8m-2.6 4c-.2 0-.5 0-.7.4-.2.4-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.7 2.8 4.3 3.8 2.1.8 2.5.7 3 .6.5 0 1.5-.6 1.7-1.2s.2-1.1.2-1.2c-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.1-.7.1l-.8 1c-.1.2-.3.2-.6.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4 0-.5.2-.7l.5-.6.3-.5v-.5l-.9-2c-.2-.5-.4-.5-.6-.5z",
  },
  {
    id: "x",
    name: "X",
    href: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
    pfadD:
      "M17.5 3h3l-6.6 7.6L21.7 21h-6l-4.7-6.2L5.5 21h-3l7-8.1L2.6 3h6.2l4.3 5.7zm-1 16.2h1.6L7.6 4.7H5.8z",
  },
  {
    id: "facebook",
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    pfadD:
      "M22 12a10 10 0 1 0-11.6 9.9v-7h-2.5V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 22 12",
  },
  {
    id: "email",
    name: "E-Mail",
    href: `mailto:?subject=${t}&body=${t}%0A%0A${u}`,
    pfadD:
      "M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1m1.6 2L12 12.3 19.4 7zM20 8.6l-7.4 5.3a1 1 0 0 1-1.2 0L4 8.6V17h16z",
  },
];
---

<div class="teilen" class:list={[kompakt && "kompakt"]} data-teilen data-url={url} data-titel={titel}>
  <span class="label">Teilen</span>

  <div class="knoepfe">
    {/* Nur sichtbar, wenn der Browser das native Teilen-Menü kann — dort
        stecken Instagram, TikTok, Signal und alles andere Installierte. */}
    <button type="button" class="knopf nativ" data-teilen-nativ hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 3v12M8.5 6.5 12 3l3.5 3.5M5 13v6a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="sr-only">Über das Gerät teilen</span>
    </button>

    {
      dienste.map((d) => (
        <a
          class="knopf"
          href={d.href}
          target="_blank"
          rel="noopener noreferrer"
          data-dienst={d.id}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={d.pfadD} fill="currentColor" />
          </svg>
          <span class="sr-only">Bei {d.name} teilen</span>
        </a>
      ))
    }

    <button type="button" class="knopf" data-teilen-kopieren>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M10 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1.2 1.2M14 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1.2-1.2"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
      <span class="sr-only">Link kopieren</span>
    </button>

    <span class="rueckmeldung" data-teilen-status role="status" aria-live="polite"></span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-teilen]").forEach((leiste) => {
    const url = leiste.dataset.url ?? location.href;
    const titel = leiste.dataset.titel ?? document.title;
    const status = leiste.querySelector<HTMLElement>("[data-teilen-status]");

    const melden = (text: string) => {
      if (!status) return;
      status.textContent = text;
      setTimeout(() => (status.textContent = ""), 2200);
    };

    const nativ = leiste.querySelector<HTMLButtonElement>("[data-teilen-nativ]");
    if (nativ && typeof navigator.share === "function") {
      nativ.hidden = false;
      nativ.addEventListener("click", async () => {
        try {
          await navigator.share({ title: titel, url });
        } catch {
          /* Abbruch durch den Nutzer ist kein Fehler. */
        }
      });
    }

    leiste
      .querySelector<HTMLButtonElement>("[data-teilen-kopieren]")
      ?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
          melden("Link kopiert");
        } catch {
          melden("Kopieren nicht möglich");
        }
      });
  });
</script>

<style>
  .teilen {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    padding-block: 0.85rem;
    border-block: 1px solid var(--rule);
  }
  .kompakt {
    border-top: none;
    padding-top: 0;
  }

  .label {
    font-family: Archivo, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .knoepfe {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  /* 40 px auf Zeigegeräten, 44 px auf Touch — groß genug zum Treffen, klein
     genug, um neben dem Fließtext nicht zu dominieren. */
  .knopf {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    border: 1px solid transparent;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .knopf:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .knopf svg {
    width: 18px;
    height: 18px;
    display: block;
  }
  .knopf[hidden] {
    display: none;
  }

  .nativ {
    color: var(--accent);
  }

  @media (pointer: coarse) {
    .knopf {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .rueckmeldung {
    font-size: 0.79rem;
    color: var(--accent);
    min-width: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media print {
    .teilen {
      display: none;
    }
  }
</style>
