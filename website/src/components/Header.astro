---
import Logo from "./Logo.astro";
---

<header class="site-header">
  <div class="shell bar">
    <a href="/" class="brand" aria-label="Zur Startseite">
      <Logo size={26} />
    </a>
    <nav aria-label="Hauptnavigation">
      <a href="/artikel/">Vergleiche</a>
      <a href="/anbieter/">Anbieter</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    /* Klein, weil Logo und Navigationslinks ihre eigene Höhe mitbringen —
       sonst wüchse die Kopfzeile auf über 70 px. */
    padding-block: 0.3rem;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    /* 26 px Bildmarke + 2x9 px = 44 px Tippfläche. */
    padding-block: 0.56rem;
  }
  nav {
    display: flex;
    gap: 1.5rem;
    font-family: Archivo, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    /* 44 px Mindesthöhe für Tippziele (WCAG 2.5.8). */
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--ink-soft);
  }
  nav a:hover {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    .bar {
      gap: 0.75rem;
    }
    nav {
      gap: 0.95rem;
      font-size: 0.83rem;
    }
  }
</style>
