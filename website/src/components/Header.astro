---
import Logo from "./Logo.astro";
---

<header class="site-header">
  <div class="shell bar">
    <a href="/" class="brand" aria-label="Zur Startseite">
      <Logo size={26} />
    </a>
    <nav aria-label="Hauptnavigation">
      <a href="/artikel/">Vergleiche</a>
      <a href="/anbieter/">Anbieter</a>
      <a href="/methodik/">Methodik</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
  }
  nav {
    display: flex;
    gap: 1.5rem;
    font-family: Archivo, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  nav a:hover {
    color: var(--accent);
  }
</style>
