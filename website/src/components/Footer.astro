---
import { SITE } from "../config.js";
const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell inner">
    {/*
      Auflösung des Sternchens an den Affiliate-Links. Bewusst als Kurzzeile
      und nicht im Info-Widget: Ein Hinweis, der erst nach einem Klick sichtbar
      wird, gilt nach § 5a Abs. 4 UWG nicht als erkennbar. Kürzer geht es
      nicht, ohne die Kennzeichnung zu verlieren.
    */}
    <p class="stern-hinweis">
      * Affiliate-Link — wir erhalten eine Provision, für dich ohne Mehrkosten.
    </p>
    <nav class="rechtliches" aria-label="Rechtliches">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/methodik/">Methodik</a>
    </nav>

    <p class="copy">© {jahr} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 5rem;
    background: var(--surface);
  }
  .inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    /* Platz rechts, damit das Info-Widget nichts überdeckt. */
    padding: 1.5rem 1.5rem 2rem;
    padding-right: 5rem;
  }
  .stern-hinweis,
  .copy {
    margin: 0;
    font-size: 0.79rem;
    color: var(--ink-faint);
  }

  /*
   * Impressum und Datenschutz gehoeren sichtbar auf jede Seite. In die
   * Kopfzeile passen sie nicht: Mit vier Eintraegen ragte "Datenschutz" auf
   * einem 320-px-Telefon 45 px aus dem Bild. Hier ist Platz, und es ist die
   * Stelle, an der deutsche Leser danach suchen. Das Info-Widget behaelt die
   * Links zusaetzlich — § 5 DDG verlangt "staendig verfuegbar", und ein
   * mitscrollender Knopf erfuellt das auch am Anfang einer langen Seite.
   */
  .rechtliches {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    order: -1;
    flex-basis: 100%;
  }
  .rechtliches a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: Archivo, sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .rechtliches a:hover {
    color: var(--accent);
  }
</style>
