---
import { SITE } from "../config.js";
const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell inner">
    {/*
      Auflösung des Sternchens an den Affiliate-Links. Bewusst als Kurzzeile
      und nicht im Info-Widget: Ein Hinweis, der erst nach einem Klick sichtbar
      wird, gilt nach § 5a Abs. 4 UWG nicht als erkennbar. Kürzer geht es
      nicht, ohne die Kennzeichnung zu verlieren.
    */}
    <p class="stern-hinweis">
      * Affiliate-Link — wir erhalten eine Provision, für dich ohne Mehrkosten.
    </p>
    <p class="copy">© {jahr} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 5rem;
    background: var(--surface);
  }
  .inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    /* Platz rechts, damit das Info-Widget nichts überdeckt. */
    padding: 1.5rem 1.5rem 2rem;
    padding-right: 5rem;
  }
  .stern-hinweis,
  .copy {
    margin: 0;
    font-size: 0.79rem;
    color: var(--ink-faint);
  }
</style>
