# Database
DATABASE_URL=sqlite:///./data/affiliate.db

# Awin Publisher API (Phase 2)
# Get credentials from: https://upapi.awin.com/documentation
AWIN_PUBLISHER_ID=
AWIN_ACCESS_TOKEN=

# Google Ads API (Phase 3)
# Setup: https://developers.google.com/google-ads/api/docs/start
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# DataForSEO (Phase 4)
# Signup: https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Application
DEBUG=false
LOG_LEVEL=INFO
